   "boundElements": null,
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "class MenuItem {\n    String name;\n    double price;\n\n    MenuItem(String name, double price) {\n        this.name = name;\n        this.price = price;\n    }\n}\n\nMenuItem dosa = new MenuItem(\"Masala Dosa\", 120);",
   "originalText": "class MenuItem {\n    String name;\n    double price;\n\n    MenuItem(String name, double price) {\n        this.name = name;\n        this.price = price;\n    }\n}\n\nMenuItem dosa = new MenuItem(\"Masala Dosa\", 120);",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
