   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "• final variable: can't be reassigned\n• final method: subclasses can't override it\n   (Lecture 2)\n• final class: can't be extended. Example:\n   String",
   "originalText": "• final variable: can't be reassigned\n• final method: subclasses can't override it\n   (Lecture 2)\n• final class: can't be extended. Example:\n   String",
   "fontSize": 25,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
