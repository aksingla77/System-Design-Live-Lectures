  {
   "id": "tex_29",
   "type": "text",
   "x": 1982,
   "y": 1264.0,
   "width": 1469.4399999999998,
   "height": 210.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
