   "text": "enum DeliveryType {\n    STANDARD(40), EXPRESS(80);\n\n    private final int fee;\n\n    DeliveryType(int fee) {\n        this.fee = fee;\n    }\n\n    int getFee() { return fee; }\n}\n\nDeliveryType.EXPRESS.getFee();  // 80",
   "originalText": "enum DeliveryType {\n    STANDARD(40), EXPRESS(80);\n\n    private final int fee;\n\n    DeliveryType(int fee) {\n        this.fee = fee;\n    }\n\n    int getFee() { return fee; }\n}\n\nDeliveryType.EXPRESS.getFee();  // 80",
   "fontSize": 21,
   "fontFamily": 3,
